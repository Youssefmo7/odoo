<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="res_partner_form_inherit_hms"
            model="ir.ui.view">

        <field name="name">
            res.partner.form.hms
        </field>

        <field name="model">
            res.partner
        </field>

        <field name="inherit_id"
               ref="base.view_partner_form"/>

        <field name="arch"
               type="xml">

            <xpath expr="//page[@name='sales_purchases']//group"
                   position="inside">

                <field name="related_patient_id"/>

            </xpath>

            <xpath expr="//field[@name='category_id']"
                   position="after">

                <field name="website"/>

            </xpath>

            <xpath expr="//field[@name='vat']"
                   position="attributes">

                <attribute name="required">1</attribute>

            </xpath>

        </field>

    </record>

</odoo>