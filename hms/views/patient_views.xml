<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_hms_patient_tree" model="ir.ui.view">
        <field name="name">hms.patient.tree</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="blood_type"/>
                <field name="pcr"/>
            </tree>
        </field>
    </record>

    <record id="view_hms_patient_form" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="image" widget="image"/>
                    </group>

                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="birth_date"/>
                        <field name="age" readonly="1"/>
                        <field name="blood_type"/>
                        <field name="pcr"/>
                        <field name="cr_ratio"/>
                    </group>

                    <group>
                        <field name="address"/>
                    </group>

                    <notebook>
                        <page string="History">
                            <field name="history"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hms_root"
              name="HMS"/>

    <menuitem id="menu_hms_patient"
              name="Patients"
              parent="menu_hms_root"
              action="action_hms_patient"/>

</odoo>