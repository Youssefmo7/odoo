<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="patient_report_action"
            model="ir.actions.report">

        <field name="name">
            Patient Report
        </field>

        <field name="model">
            hms.patient
        </field>

        <field name="report_type">
            qweb-pdf
        </field>

        <field name="report_name">
            hms.patient_report_template
        </field>

        <field name="report_file">
            hms.patient_report_template
        </field>

        <field name="print_report_name">
            'Patient Report - %s' % (object.first_name)
        </field>

    </record>

</odoo>